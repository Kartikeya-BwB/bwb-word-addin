{
  "name": "bwb-toolkit",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/make-icon-index.mjs && node scripts/make-ribbon-icons.mjs && node scripts/make-manifest.mjs",
    "dev": "npm run assets && vite",
    "demo": "vite --open /demo.html",
    "build": "npm run assets && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy-to-root.mjs",
    "check-live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tabler/icons": "3.49.0",
    "@types/node": "24.19.2",
    "@types/office-js": "1.0.611",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xmldom/xmldom": "0.9.12",
    "d3-geo": "3.1.1",
    "flag-icons": "7.5.0",
    "lucide-static": "1.52.0",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "world-atlas": "2.0.2"
  }
}
