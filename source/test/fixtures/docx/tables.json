              ["Total", "", "USD 330m", ""]],
     "align": [null, "center", "right", "left"], "total_row": true,
     "caption": "Table 7: Portfolio by stage.", "source": "BwB analysis, 2026"},
    {"type": "table", "style": "comparison", "header": ["Term", "Definition"], "widths": [30, 70],
     "rows": [["Blended finance", "Concessional capital that mobilises commercial capital."],
              ["First loss", "Capital that absorbs the first losses.\n\nA second paragraph in the same cell."]],
     "caption": "Key terms."},
    {"type": "table", "style": "status", "header": ["Country", "Status"], "rows": [["Colombia", "Active"], ["Peru", "Concluded"]],
