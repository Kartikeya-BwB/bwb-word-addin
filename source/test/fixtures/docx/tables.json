    {"type": "table", "header": ["C1", "C2", "C3", "C4", "C5", "C6", "C7", "C8", "C9", "C10"],
     "rows": [["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"]]},
    {"type": "heading", "level": 1, "text": "Irregular tables"},
    {"type": "table", "header": ["Only one"], "rows": [["x", "y", "z"], ["short"]], "caption": "Header shorter than the rows."},
    {"type": "table", "rows": [["No header", "row"], ["second", "row"]], "caption": "No header row."},
    {"type": "table", "header": ["Item", "Detail", "Amount"],
     "rows": [["Bullets", {"bullets": ["First point", "Second **bold** point"]}, 12],
