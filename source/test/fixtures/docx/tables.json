              ["Link", "[BwB](https://bwb.earth) site^[A footnote in a table cell.]", 0]],
     "align": [null, null, "right"], "caption": "Mixed cell contents."},
    {"type": "table", "header": ["#", "Milestone"],
     "rows": [["1", "Scoping"], ["2", "Mandate"], ["3", "Structuring"], ["4", "Investors"], ["5", "Terms"], ["6", "Due diligence"],
